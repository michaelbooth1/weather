{
  "schema_version": "exchange_economics_snapshot_v0.3",
  "platform": "polymarket_global",
  "platform_surface": "international_clob",
  "max_age_hours": 24,
  "source_urls": [
    "https://docs.polymarket.com/trading/fees",
