+def report_size(report):
+    """len(raw) + len(markdown) of report_bytes(report), without holding the raw JSON."""
+    size = 1 + sum(len(chunk) for chunk in _chunks(report))
+    _, markdown = _markdown(report)
+    return size + len(markdown)
