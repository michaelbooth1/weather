+_BATCH = 512
+
+
+def _dumps(value):
+    return json.dumps(plain(value), sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False)
+
+
+def _big(value):
+    if is_dataclass(value) and not isinstance(value, type):
+        return len(fields(value)) > _BATCH
+    return isinstance(value, (Mapping, list, tuple)) and len(value) > _BATCH
+
+
+def _chunks(value):
+    """canonical_bytes(value) without the newline, as text chunks; never one plain() copy of a big container."""
+    if is_dataclass(value) and not isinstance(value, type):
+        value = {f.name: getattr(value, f.name) for f in fields(value)}
+    elif isinstance(value, Mapping):
+        if any(not isinstance(k, str) for k in value):
+            raise ValueError("canonical mappings require string keys")
+    elif not isinstance(value, (list, tuple)):
+        yield _dumps(value)
+        return
+    if isinstance(value, Mapping):
+        yield "{"
+        for i, key in enumerate(sorted(value)):
+            yield ("," if i else "") + json.dumps(key, ensure_ascii=True) + ":"
+            yield from _chunks(value[key])
+        yield "}"
+        return
+    yield "["
+    first, batch = True, []
+    def flush():
+        nonlocal first
+        if batch:
+            yield ("" if first else ",") + _dumps(batch)[1:-1]
+            first = False
+            batch.clear()
+    for item in value:
+        if isinstance(item, (Mapping, list, tuple)) or (is_dataclass(item) and not isinstance(item, type)):
+            if _big(item) or any(_big(v) for v in (item.values() if isinstance(item, Mapping) else
+                                 item if isinstance(item, (list, tuple)) else
+                                 (getattr(item, f.name) for f in fields(item)))):
+                yield from flush()
+                if not first:
+                    yield ","
+                first = False
+                yield from _chunks(item)
+                continue
+        batch.append(item)
+        if len(batch) >= _BATCH:
+            yield from flush()
+    yield from flush()
+    yield "]"
+
+
+def _digest(value):
+    """journal.digest(value) without one plain() copy of a big container."""
+    h = hashlib.sha256()
+    for chunk in _chunks(value):
+        h.update(chunk.encode("ascii"))
+    h.update(bytes([10]))
+    return h.hexdigest()
+
