# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environment ---
venv/
.venv/
env/

# --- Local credentials ---
.env

# --- Raw source payloads (large, regenerable auditability backups) ---
# ~600 MB+ of provider JSON/XML/CSV. Rebuildable from the network via the
# collector CLIs (e.g. `python -m weather.sources.wu_history backfill`), and normalized
# hourly/daily artifacts are derived from these.
data/

# Candidate-only training outputs are reproducible, unqualified runtime state.
# Immutable releases copy only explicitly verified artifacts into their own
# write-once manifests; a research/BLOCK pickle must never enter source control.
artifacts/candidates/

# --- Runtime / transient state (not source of truth) ---
*.log
scratch/
data/wunderground/*/last_good_sources.json
data/snapshots/loop_pause.flag
**/.snapshot.lock

# --- Reconstructed replay corpus (approximate, regenerable) ---
# Bootstrapped from snapshots.jsonl via `python -m weather.backtesting.replay`; large and
# approximate. The committed replay_inputs.jsonl holds only real captured inputs.
data/snapshots/**/replay_inputs_reconstructed.jsonl

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
