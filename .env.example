# Polymarket authenticated read-only configuration.
# Copy values into a local .env file or export them in the process environment.
# Local .env files are ignored by git; do not commit real credentials.

# CLOB/API connection
POLYMM_CLOB_HOST=https://clob.polymarket.com
POLYMM_CHAIN_ID=137

# Wallet/funder setup
# Signature type values: 0=EOA/deposit wallet, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271.
POLYMM_WALLET_ADDRESS=0xREPLACE_WITH_SIGNER_WALLET_ADDRESS
POLYMM_FUNDER_ADDRESS=0xREPLACE_WITH_FUNDER_OR_DEPOSIT_WALLET_ADDRESS
POLYMM_SIGNATURE_TYPE=0

# L2 API credentials derived from Polymarket L1 auth.
POLYMM_API_KEY=REPLACE_WITH_POLYMARKET_API_KEY
POLYMM_API_SECRET=REPLACE_WITH_POLYMARKET_API_SECRET
POLYMM_API_PASSPHRASE=REPLACE_WITH_POLYMARKET_API_PASSPHRASE

# Keep live trading disabled except inside an explicitly approved confirmed live-write shell.
POLYMM_LIVE_TRADING=false

# Optional operator alert webhook. Alerts still write SQLite + logs/alerts.log when unset.
# POLYMM_ALERT_WEBHOOK_URL=https://example.invalid/polymm-alerts
