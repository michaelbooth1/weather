# One-time International Polymarket credential-import source template.
# Keep the populated file outside the repository with a private ACL. Never
# source it into the process environment; the live pilot consumes only the
# wincred:// reference manifest produced by mm_credential_import_cli.

# CLOB/API connection
POLYMM_CLOB_HOST=https://clob.polymarket.com
POLYMM_CHAIN_ID=137

# Wallet/funder setup
# This pilot accepts exactly two documented topologies:
# 2=existing Gnosis Safe (EOA order signer, distinct Safe funder)
# 3=new deposit wallet/POLY_1271 (deposit-wallet order signer and funder)
POLYMM_WALLET_ADDRESS=0xREPLACE_WITH_SIGNER_WALLET_ADDRESS
POLYMM_FUNDER_ADDRESS=0xREPLACE_WITH_FUNDER_OR_DEPOSIT_WALLET_ADDRESS
POLYMM_SIGNATURE_TYPE=2

# L2 API credentials derived from Polymarket L1 auth.
POLYMM_API_KEY=REPLACE_WITH_POLYMARKET_API_KEY
POLYMM_API_SECRET=REPLACE_WITH_POLYMARKET_API_SECRET
POLYMM_API_PASSPHRASE=REPLACE_WITH_POLYMARKET_API_PASSPHRASE
POLYMM_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY

# This self-assertion is deliberately ignored by the importer and never grants
# trading authority. The fresh geoblock, readiness, risk, release, and literal
# confirmation gates remain authoritative.
POLYMM_LIVE_TRADING=false

# Optional operator alert webhook. Alerts still write SQLite + logs/alerts.log when unset.
# POLYMM_ALERT_WEBHOOK_URL=https://example.invalid/polymm-alerts
