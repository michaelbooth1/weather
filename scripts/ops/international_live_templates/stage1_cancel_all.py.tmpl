def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _current_execution_host_id() -> str:
    try:
        with winreg.OpenKey(
            winreg.HKEY_LOCAL_MACHINE,
            r"SOFTWARE\Microsoft\Cryptography",
            access=winreg.KEY_READ | winreg.KEY_WOW64_64KEY,
        ) as key:
            machine, value_type = winreg.QueryValueEx(key, "MachineGuid")
    except OSError as exc:
        raise RuntimeError("execution host identity is unavailable") from exc
    if value_type != winreg.REG_SZ or not str(machine).strip():
        raise RuntimeError("execution host identity is unavailable")
    material = "\0".join((EXECUTION_HOST_ID_DOMAIN, str(machine).strip().casefold()))
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def _run(command: list[str], *, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        cwd=PRODUCTION,
        text=True,
        capture_output=True,
        check=False,
        timeout=10,
    )
    if result.returncode not in allowed:
        raise RuntimeError(f"sealed public preflight exited {result.returncode}")
    return result


def _git(*args: str, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    environment = {
        key: value
        for key, value in os.environ.items()
        if not key.upper().startswith("GIT_")
        and key.upper()
        not in {
            "ALL_PROXY", "CURL_CA_BUNDLE", "HTTP_PROXY", "HTTPS_PROXY",
            "NO_PROXY", "REQUESTS_CA_BUNDLE", "SSL_CERT_DIR", "SSL_CERT_FILE",
            "WEATHER_MARKET_REGISTRY",
        }
    }
    environment.update(
        {
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_OPTIONAL_LOCKS": "0",
            "GCM_INTERACTIVE": "Never",
        }
    )
    command = [
        str(SCOPE["git_executable"]),
        "-c",
        "credential.helper=",
        "-c",
        "credential.interactive=false",
        "-c",
        f"core.hooksPath={os.devnull}",
        "-C",
        str(PRODUCTION),
        *args,
    ]
    result = subprocess.run(
        command,
        cwd=PRODUCTION,
        env=environment,
        text=True,
        capture_output=True,
        check=False,
        timeout=10,
    )
    if result.returncode not in allowed:
        raise RuntimeError(f"sealed Git preflight exited {result.returncode}")
    return result


def _is_fully_sealed() -> bool:
    if not TEMPLATE_SEALED or not isinstance(SCOPE, dict) or not isinstance(
        SOURCE_SHA256, dict
    ):
        return False
    return True


def _assert_sealed() -> None:
    if not _is_fully_sealed():
        raise RuntimeError("fixed-scope Stage 1 template is not sealed")
    if not isinstance(SCOPE["allowed_status_flag_sha256"], list):
        raise RuntimeError("allowed status hashes are not sealed as a list")
    if any(
        SHA256_RE.fullmatch(str(value).lower()) is None
        for value in SCOPE["allowed_status_flag_sha256"]
    ):
        raise RuntimeError("allowed status hashes contain an invalid value")
    profile = str(SCOPE.get("execution_host_profile") or "")
    if profile not in {
        CAPTURE_COLOCATED_HOST_PROFILE,
        PORTABLE_EXECUTION_HOST_PROFILE,
    }:
        raise RuntimeError("execution host profile is invalid")
    expected_branch = str(SCOPE.get("expected_production_branch") or "")
    expected_remote_ref = str(SCOPE.get("expected_remote_branch_ref") or "")
    if (
        profile == CAPTURE_COLOCATED_HOST_PROFILE
        and expected_branch != "master"
    ) or (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and expected_branch not in {"master", PORTABLE_TOPIC_BRANCH}
    ) or expected_remote_ref != f"refs/heads/{expected_branch}":
        raise RuntimeError("sealed production branch is invalid for the host profile")
    if (
        SHA256_RE.fullmatch(str(SCOPE.get("execution_host_id") or "").lower())
        is None
        or str(SCOPE["execution_host_id"]).lower()
        != _current_execution_host_id()
    ):
        raise RuntimeError("wrapper is sealed for a different execution host")
    if (
        SHA256_RE.fullmatch(
            str(SCOPE.get("git_executable_sha256") or "").lower()
        )
        is None
        or not Path(str(SCOPE.get("git_executable") or "")).is_absolute()
        or SCOPE.get("canonical_origin_url")
        != "https://github.com/michaelbooth1/weather.git"
    ):
        raise RuntimeError("sealed Git trust binding is invalid")
    if (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and SCOPE["allowed_status_flag_sha256"]
    ):
        raise RuntimeError("portable execution host has capture status exceptions")
    try:
        market_timezone = ZoneInfo(str(SCOPE.get("market_timezone") or ""))
    except Exception as exc:
        raise RuntimeError("sealed market timezone is invalid") from exc
    if not str(SCOPE.get("market_id") or "").strip() or not market_timezone:
        raise RuntimeError("sealed market calendar binding is invalid")
    condition = str(SCOPE["condition_id"]).lower()
    token = str(SCOPE["token_id"])
    if CONDITION_RE.fullmatch(condition) is None:
        raise RuntimeError("fixed condition id is invalid")
    if not token.isdigit() or int(token) <= 0:
        raise RuntimeError("fixed token id is invalid")
    budget = float(SCOPE["requested_budget_pusd"])
    if budget != 10:
        raise RuntimeError("fixed requested budget is not exactly 10 pUSD")
    if CANCELLATION_MODE not in {"cancel_all", "dead_man"}:
        raise RuntimeError("sealed cancellation mode is invalid")
    _assert_window_current()


def _assert_window_current() -> None:
    start = datetime.fromisoformat(str(SCOPE["run_not_before_local"]))
    stop = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    now = datetime.now().astimezone()
    cleanup_reserve = SCOPE.get("cleanup_reserve_seconds")
    if start.tzinfo is None or stop.tzinfo is None or not start < stop:
        raise RuntimeError("fixed local run window is invalid")
    if (
        isinstance(cleanup_reserve, bool)
        or not isinstance(cleanup_reserve, int)
        or cleanup_reserve <= 0
    ):
        raise RuntimeError("fixed cleanup reserve is invalid")
    if (stop - start).total_seconds() > 30 * 60:
        raise RuntimeError("fixed local run window exceeds 30 minutes")
    calendar_timezone = (
        LIVE_WINDOW_TIMEZONE
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        else ZoneInfo(SCOPE["market_timezone"])
    )
    local_start = start.astimezone(calendar_timezone)
    local_stop = stop.astimezone(calendar_timezone)
    local_contained_end = (
        stop + timedelta(seconds=cleanup_reserve)
    ).astimezone(calendar_timezone)
    start_wall = (
        local_start.hour,
        local_start.minute,
        local_start.second,
        local_start.microsecond,
    )
    contained_end_wall = (
        local_contained_end.hour,
        local_contained_end.minute,
        local_contained_end.second,
        local_contained_end.microsecond,
    )
    execution_date = local_start.date()
    execution_dates_match = (
        local_stop.date() == execution_date
        and local_contained_end.date() == execution_date
    )
    capture_target_date_matches = (
        execution_date.isoformat() == SCOPE["target_date"]
    )
    portable_target_date_matches = SCOPE["target_date"] in {
        execution_date.isoformat(),
        (execution_date + timedelta(days=1)).isoformat(),
    }
    profile_date_matches = (
        capture_target_date_matches
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        else portable_target_date_matches
    )
    colocated_window_matches = (
        start_wall >= LIVE_WINDOW_START
        and contained_end_wall <= LIVE_WINDOW_END
    )
    if not execution_dates_match or not profile_date_matches or (
        SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        and not colocated_window_matches
    ):
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE:
            raise RuntimeError(
                "fixed execution plus cleanup reserve is outside the supported "
                "00:30-09:00 America/Toronto live window"
            )
        raise RuntimeError(
            "fixed portable execution requires one local execution date and "
            "a current-day or next-day market target"
        )
    if not start <= now <= stop or (
        now.astimezone(calendar_timezone).date() != execution_date
    ):
        raise RuntimeError("fixed-scope Stage 1 wrapper is outside its exact window")


def _prompt_until(expected: str, reserve_seconds: int | None = None) -> str:
    reserve = (
        PRE_CREDENTIAL_RESERVE_SECONDS
        if reserve_seconds is None
        else int(reserve_seconds)
    )
    if reserve <= 0:
        raise RuntimeError("supervised confirmation reserve must be positive")
    deadline = datetime.fromisoformat(str(SCOPE["run_not_after_local"])) - timedelta(
        seconds=reserve
    )
    sys.stdout.write(f"Type {expected} to continue: ")
    sys.stdout.flush()
    characters: list[str] = []
    while datetime.now().astimezone() < deadline:
        if not msvcrt.kbhit():
            time.sleep(0.05)
            continue
        character = msvcrt.getwch()
        if character in ("\r", "\n"):
            sys.stdout.write("\n")
            sys.stdout.flush()
            return "".join(characters)
        if character == "\x03":
            raise KeyboardInterrupt()
        if character == "\b":
            if characters:
                characters.pop()
                sys.stdout.write("\b \b")
                sys.stdout.flush()
            continue
        if character.isprintable():
            characters.append(character)
            sys.stdout.write(character)
            sys.stdout.flush()
    raise TimeoutError("supervised confirmation expired at the sealed deadline")


def _assert_reserve(reserve_seconds: int, *, label: str) -> None:
    deadline = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    if (deadline - datetime.now().astimezone()).total_seconds() < reserve_seconds:
        raise RuntimeError(f"sealed Stage 1 {label} reserve is exhausted")


def _assert_precredential_reserve() -> None:
    _assert_reserve(PRE_CREDENTIAL_RESERVE_SECONDS, label="pre-credential")


def _assert_mutation_reserve() -> None:
    _assert_reserve(PRE_MUTATION_RESERVE_SECONDS, label="pre-mutation")


def _display_confirmation_scope() -> str:
    contained_end = datetime.fromisoformat(
        str(SCOPE["run_not_after_local"])
    ) + timedelta(seconds=SCOPE["cleanup_reserve_seconds"])
    payload = {
        "stage": STAGE_NAME,
        "cancellation_mode": CANCELLATION_MODE,
        "target_date": SCOPE["target_date"],
        "condition_id": SCOPE["condition_id"],
        "token_id": SCOPE["token_id"],
        "requested_budget_pusd": 10,
        "wallet_cap_pusd": 100,
        "cutoff_local": SCOPE["run_not_after_local"],
        "cleanup_reserve_seconds": SCOPE["cleanup_reserve_seconds"],
        "contained_process_end_local": contained_end.isoformat(),
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    print(json.dumps({"confirmation_scope": payload}, sort_keys=True))
    return hashlib.sha256(encoded).hexdigest()


def _assert_git_and_sources() -> None:
    from weather.operations.live_path_security import (
        assert_no_ambient_proxy_configuration,
    )

    assert_no_ambient_proxy_configuration()
    if Path(sys.executable).resolve() != PRODUCTION_PYTHON.resolve():
        raise RuntimeError("fixed-scope wrapper is not using the production interpreter")
    git_executable = Path(str(SCOPE["git_executable"]))
    if (
        not git_executable.is_file()
        or _sha256(git_executable)
        != str(SCOPE["git_executable_sha256"]).lower()
    ):
        raise RuntimeError("sealed Git executable changed")
    origin_url = _git(
        "config", "--local", "--get", "remote.origin.url"
    ).stdout.strip()
    push_url = _git(
        "config",
        "--local",
        "--get-all",
        "remote.origin.pushurl",
        allowed=(0, 1),
    ).stdout.strip()
    config_names = _git(
        "config", "--local", "--name-only", "--list"
    ).stdout.splitlines()
    forbidden_prefixes = (
        "url.", "include.", "includeif.", "http.", "credential.",
        "core.sshcommand", "remote.origin.proxy",
    )
    if (
        origin_url != SCOPE["canonical_origin_url"]
        or push_url
        or any(
            name.casefold().startswith(forbidden_prefixes)
            for name in config_names
        )
    ):
        raise RuntimeError("production Git remote or trust configuration changed")
    profile = str(SCOPE["execution_host_profile"])
    selected_branch = str(SCOPE["expected_production_branch"])
    if (
        profile == CAPTURE_COLOCATED_HOST_PROFILE
        and selected_branch != "master"
    ) or (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and selected_branch not in {"master", PORTABLE_TOPIC_BRANCH}
    ):
        raise RuntimeError("sealed production branch is invalid for the host profile")
    selected_local_ref = f"refs/heads/{selected_branch}"
    selected_cached_ref = f"refs/remotes/origin/{selected_branch}"
    selected_remote_ref = str(SCOPE["expected_remote_branch_ref"])
    if selected_remote_ref != selected_local_ref:
        raise RuntimeError("sealed remote branch ref does not match the selected branch")
    master_remote_ref = "refs/heads/master"
    head = _git("rev-parse", "HEAD").stdout.strip().lower()
    local_selected = _git("rev-parse", selected_local_ref).stdout.strip().lower()
    cached_selected = _git("rev-parse", selected_cached_ref).stdout.strip().lower()
    master = _git("rev-parse", "refs/heads/master").stdout.strip().lower()
    cached_master = _git(
        "rev-parse", "refs/remotes/origin/master"
    ).stdout.strip().lower()
    branch = _git("branch", "--show-current").stdout.strip()
    required_remote_refs = sorted({master_remote_ref, selected_remote_ref})
    assert_no_ambient_proxy_configuration()
    remote_result = _git(
        "ls-remote",
        "--exit-code",
        "--refs",
        SCOPE["canonical_origin_url"],
        *required_remote_refs,
    )
    assert_no_ambient_proxy_configuration()
    remote_rows = [
        line.split()
        for line in remote_result.stdout.splitlines()
        if line.strip()
    ]
    remote_by_ref = {}
    for row in remote_rows:
        if (
            len(row) != 2
            or row[1] not in required_remote_refs
            or row[1] in remote_by_ref
            or GIT_OID_RE.fullmatch(row[0].lower()) is None
        ):
            raise RuntimeError("live origin ref proof is malformed or unavailable")
        remote_by_ref[row[1]] = row[0].lower()
    if set(remote_by_ref) != set(required_remote_refs):
        raise RuntimeError("live origin ref proof is malformed or unavailable")
    remote_master = remote_by_ref[master_remote_ref]
    remote_selected = remote_by_ref[selected_remote_ref]
    if not (
        head
        == local_selected
        == cached_selected
        == remote_selected
        == str(SCOPE["expected_production_tip"]).lower()
        and master == cached_master == remote_master
        and branch == selected_branch
    ):
        raise RuntimeError("production selected ref, master baseline, or branch changed")
    base_ancestry = _git(
        "merge-base",
        "--is-ancestor",
        remote_master,
        head,
        allowed=(0, 1),
    )
    if base_ancestry.returncode != 0:
        raise RuntimeError("live origin master is not an ancestor of the selected tip")
    tree = _git("rev-parse", "HEAD^{tree}").stdout.strip().lower()
    if tree != str(SCOPE["expected_production_tree"]).lower():
        raise RuntimeError("production tree changed after wrapper review")
    hardening = _git(
        "merge-base",
        "--is-ancestor",
        HARDENING_TIP,
        head,
        allowed=(0, 1),
    )
    if hardening.returncode != 0:
        raise RuntimeError("interrupt-cleanup hardening is not integrated")
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
        if _git("rev-parse", "-q", "--verify", marker, allowed=(0, 1)).returncode == 0:
            raise RuntimeError("production has an in-progress Git operation")
    dirty = {
        line[3:].replace("\\", "/")
        for line in _git("status", "--porcelain=v1").stdout.splitlines()
        if line.strip()
    }
    execution_profile = str(SCOPE["execution_host_profile"])
    worktree_policy_clean = (
        not dirty
        if execution_profile == "portable_execution_v1"
        else dirty.issubset(ALLOWED_DIRTY_PATHS)
    )
    if not worktree_policy_clean:
        raise RuntimeError("production worktree has unexpected changes")
    for relative, expected in SOURCE_SHA256.items():
        path = (PRODUCTION / relative).resolve()
        if not path.is_file() or _sha256(path) != str(expected).lower():
            raise RuntimeError("reviewed live source hash changed")


def _assert_paths_and_stage0(*, doctor_may_exist: bool = False) -> None:
    from weather.operations.live_path_security import (
        launcher_host_attestations_are_valid,
    )

    root = Path(str(SCOPE["attempt_root"])).resolve()
    input_names = [
        "identity",
        "bootstrap",
        "stage0_receipt",
        "stage0_seal_receipt",
        "stage0_run_receipt",
        "stage0_run_receipt_sidecar",
        "stage0_wrapper_execution_receipt",
        "candidate_plan",
        "event_metadata",
        "credential_import_receipt",
        "credential_reference_manifest",
    ]
    if CANCELLATION_MODE == "dead_man":
        input_names.extend(
            [
                "cancel_all_seal_receipt",
                "cancel_all_run_receipt",
                "cancel_all_run_receipt_sidecar",
                "cancel_all_wrapper_execution_receipt",
                "cancel_all_command_receipt",
                "cancel_all_result",
                "cancel_all_lifecycle_journal",
            ]
        )
    inputs = {
        name: (
            Path(str(SCOPE[f"{name}_path"])).resolve(),
            str(SCOPE[f"{name}_sha256"]).lower(),
        )
        for name in input_names
    }
    output_names = (
        "doctor_receipt_out",
        "geography_precredential_receipt_out",
        "geography_presubmit_receipt_out",
        "result_out",
        "command_receipt_out",
        "user_stream_journal_out",
        "lifecycle_journal_out",
        "wrapper_execution_receipt_out",
    )
    outputs = {
        name: Path(str(SCOPE[name])).resolve()
        for name in output_names
    }
    all_paths = [path for path, _expected in inputs.values()] + list(outputs.values())
    if len(all_paths) != len(set(all_paths)):
        raise RuntimeError("fixed input/output paths are not distinct")
    external_inputs = {
        inputs["credential_import_receipt"][0],
        inputs["credential_reference_manifest"][0],
    }
    for path in all_paths:
        if path in external_inputs:
            continue
        if root != path and root not in path.parents:
            raise RuntimeError("fixed path escapes the reviewed attempt root")
    for path, expected in inputs.values():
        if (
            not path.is_file()
            or SHA256_RE.fullmatch(expected) is None
            or _sha256(path) != expected
        ):
            raise RuntimeError("fixed Stage 1 input is absent or hash-mismatched")
    if any(
        path.exists()
        for name, path in outputs.items()
        if not (doctor_may_exist and name == "doctor_receipt_out")
    ):
        raise RuntimeError("fixed Stage 1 output path already exists")
    stage0 = json.loads(inputs["stage0_receipt"][0].read_text(encoding="utf-8-sig"))
    stage0_topology = stage0.get("credential_topology") or {}
    reference_manifest = json.loads(
        inputs["credential_reference_manifest"][0].read_text(encoding="utf-8-sig")
    )
    if not all(
        (
            stage0.get("schema_version") == "mm_live_pilot_command_receipt_v0.2",
            stage0.get("status") == "PASS",
            stage0.get("command") == "stage0",
            stage0.get("target_date") == SCOPE["target_date"],
            str(stage0.get("condition_id") or "").lower()
            == str(SCOPE["condition_id"]).lower(),
            str(stage0.get("token_id") or "") == str(SCOPE["token_id"]),
            float(stage0.get("requested_budget_pusd"))
            == float(SCOPE["requested_budget_pusd"]),
            (stage0.get("cleanup") or {}).get("ok") is True,
            stage0.get("authenticated_user_stream_subscription_sent") is True,
            stage0.get("bootstrap_phase") == "complete",
            stage0.get("exchange_mutation_attempt_counts")
            == {"cancel_all": 1, "heartbeat": 2},
            stage0.get("exception_type") is None,
        )
    ):
        raise RuntimeError("fixed Stage 0 receipt does not bind the Stage 1 scope")
    seal = json.loads(
        inputs["stage0_seal_receipt"][0].read_text(encoding="utf-8-sig")
    )
    execution = json.loads(
        inputs["stage0_wrapper_execution_receipt"][0].read_text(
            encoding="utf-8-sig"
        )
    )
    stage0_run = json.loads(
        inputs["stage0_run_receipt"][0].read_text(encoding="utf-8-sig")
    )
    stage0_run_child = stage0_run.get("child_execution") or {}
    stage0_run_sidecar = inputs["stage0_run_receipt_sidecar"][0].read_text(
        encoding="ascii"
    )
    seal_scope = seal.get("scope") or {}
    seal_production = seal.get("production") or {}
    seal_wrapper = seal.get("wrapper") or {}
    seal_credential = seal.get("credential_import_receipt") or {}
    seal_reference = seal.get("credential_reference_manifest") or {}
    execution_wrapper = execution.get("wrapper") or {}
    artifacts = execution.get("artifacts") or {}
    stage0_geography_artifact = (
        artifacts.get("geography_precredential_receipt_out") or {}
    )
    stage0_premutation_geography_artifact = (
        artifacts.get("geography_premutation_receipt_out") or {}
