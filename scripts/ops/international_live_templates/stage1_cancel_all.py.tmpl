def _assert_host_state() -> None:
    _assert_window_current()
    from weather.operations.live_path_security import (
        LivePathSecurityError,
        canonical_windows_powershell,
        validate_launcher_lease_process_lineage,
    )

    powershell = canonical_windows_powershell()
    portable = (
        SCOPE["execution_host_profile"] == PORTABLE_EXECUTION_HOST_PROFILE
    )
    status_script = (
        "international_live_execution_host_status.ps1"
        if portable
        else "status.ps1"
    )
    status_result = _run(
        [
            str(powershell),
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            str(PRODUCTION / "scripts" / "ops" / status_script),
            "-Json",
            "-RepoRoot",
            str(PRODUCTION),
        ],
        allowed=(0, 2),
    )
    status = json.loads(status_result.stdout)
    observed_flag_hashes = sorted(
        hashlib.sha256(str(flag).encode("utf-8")).hexdigest()
        for flag in status.get("flags") or []
    )
    if observed_flag_hashes != sorted(SCOPE["allowed_status_flag_sha256"]):
        raise RuntimeError("execution host status flags differ from the sealed set")
    if portable:
        if (
            status_result.returncode != 0
            or status.get("status") != "PASS"
            or status.get("flags") != []
            or status.get("schema_version")
            != "international_live_execution_host_status_v0.3"
            or status.get("execution_host_id") != SCOPE["execution_host_id"]
            or SHA256_RE.fullmatch(
                str(status.get("execution_principal_id") or "").lower()
            )
            is None
            or (status.get("execution_host_assignment") or {}).get(
                "current_assignment_matches"
            )
            is not True
            or Path(str(status.get("repository_root") or "")).resolve()
            != PRODUCTION.resolve()
            or status.get("credential_access") is not False
            or status.get("exchange_contact") is not False
            or status.get("scheduler_mutation") is not False
            or status.get("capture_mutation") is not False
        ):
            raise RuntimeError("portable execution host status contract changed")
    else:
        today = str((status.get("streak") or {}).get("today") or "")
        if not (today.startswith("ON_TRACK") or today.startswith("CLEAN")):
            raise RuntimeError("capture day is not healthy")
        runtime = status.get("capture_runtime") or {}
        if not CORE_WORKERS.issubset(runtime):
            raise RuntimeError("core capture runtime status is incomplete")
        if any(
            runtime[name].get("parsed") is not True
            or runtime[name].get("consecutive_errors") != 0
            or runtime[name].get("last_error_present") is True
            for name in CORE_WORKERS
        ):
            raise RuntimeError("core capture has an unclean current state")
        tape = status.get("execution_tape") or {}
        if not all(
            (
                tape.get("armed") is True,
                tape.get("process_healthy") is True,
                tape.get("capture_state") == "CONNECTED",
                tape.get("evidence_integrity") == "PASS",
                float(tape.get("heartbeat_age_seconds")) <= 15,
            )
        ):
            raise RuntimeError("public execution capture is not healthy")
    clock = status.get("clock") or {}
    if (
        clock.get("synchronized") is not True
        or clock.get("sync_age_hours") is None
        or not 0 <= float(clock["sync_age_hours"]) <= 24
    ):
        raise RuntimeError("host clock is not synchronized")
    if (status.get("resilience") or {}).get("reboot_pending") is not False:
        raise RuntimeError("host has a pending reboot")
    lock_path = PRODUCTION / "data" / "logs" / "heavy_workload.lock"
    try:
        owner = json.loads(lock_path.read_text(encoding="utf-8-sig"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError("fixed-scope launcher lease record is unavailable") from exc
    try:
        owner_pid = int(owner.get("pid"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("fixed-scope launcher lease owner is invalid") from exc
    if not (
        owner.get("schema_version") == "weather_heavy_workload_lease_v3"
        and owner.get("workload") == SCOPE["expected_lease_workload"]
        and str(owner.get("owner_process_creation_time_token") or "").startswith(
            "win32-filetime:"
        )
        and owner.get("execution_host_profile")
        == SCOPE["execution_host_profile"]
        and owner.get("execution_host_id") == SCOPE["execution_host_id"]
        and (
            SCOPE["execution_host_profile"] != PORTABLE_EXECUTION_HOST_PROFILE
            or owner.get("execution_principal_id")
            == status.get("execution_principal_id")
        )
    ):
        raise RuntimeError("fixed-scope wrapper does not own the shared launcher lease")
    try:
        lease_process_lineage = validate_launcher_lease_process_lineage(
            lease_owner_pid=owner_pid,
            lease_path=lock_path,
            expected_owner_creation_time_token=owner[
                "owner_process_creation_time_token"
            ],
            expected_owner_executable=powershell,
            expected_pyvenv_config=PRODUCTION_PYVENV_CONFIG,
            expected_pyvenv_config_sha256=PRODUCTION_PYVENV_CONFIG_SHA256,
            expected_redirector_executable=PRODUCTION_PYTHON,
            expected_redirector_sha256=PRODUCTION_PYTHON_SHA256,
            expected_runtime_executable=PRODUCTION_RUNTIME_PYTHON,
            expected_runtime_sha256=PRODUCTION_RUNTIME_PYTHON_SHA256,
        )
    except LivePathSecurityError as exc:
        raise RuntimeError(
            "fixed-scope wrapper does not own the shared launcher lease"
        ) from exc
    HOST_ATTESTATIONS.append(
        {
            "checked_at_local": datetime.now().astimezone().isoformat(),
            "status_json_sha256": hashlib.sha256(
                status_result.stdout.encode("utf-8")
            ).hexdigest(),
            "status_flag_sha256": observed_flag_hashes,
            "execution_host_profile": SCOPE["execution_host_profile"],
            "execution_host_id": SCOPE["execution_host_id"],
            "lease_process_lineage": lease_process_lineage,
        }
    )


def _atomic_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())


def _run_geography_check(output_name: str) -> dict:
    from weather.market import mm_geographic_eligibility as geography
    from weather.operations.live_path_security import (
        assert_no_ambient_proxy_configuration,
    )

    expected_module = (
        PRODUCTION / "src/weather/market/mm_geographic_eligibility.py"
    ).resolve()
    if Path(geography.__file__).resolve() != expected_module:
        raise RuntimeError("geographic eligibility module resolved outside reviewed source")
    reserve_seconds = {
        "geography_precredential_receipt_out": PRE_CREDENTIAL_RESERVE_SECONDS,
        "geography_presubmit_receipt_out": PRE_MUTATION_RESERVE_SECONDS,
    }.get(output_name)
    if reserve_seconds is None:
        raise RuntimeError("unsupported Stage 1 geography boundary")
    confirmation = geography.PHYSICAL_LOCATION_CONFIRMATION
    if _prompt_until(confirmation, reserve_seconds=reserve_seconds).strip() != confirmation:
        raise RuntimeError("physical-location/no-circumvention confirmation did not match")
    assert_no_ambient_proxy_configuration()
    receipt = geography.check_geographic_eligibility(
        SCOPE[output_name],
        confirmation=confirmation,
        physical_location_eligible=True,
        no_circumvention=True,
    )
    assert_no_ambient_proxy_configuration()
    if receipt.get("status") != "PASS" or receipt.get("eligible") is not True:
        raise RuntimeError("geographic eligibility did not pass exactly")
    if output_name == "geography_precredential_receipt_out":
        _assert_precredential_reserve()
    else:
        _assert_mutation_reserve()
    return receipt


def _pre_submit_attestor() -> dict:
    _assert_host_state()
    return _run_geography_check("geography_presubmit_receipt_out")


def _write_execution_receipt(status: str, exception_type: str | None = None) -> None:
    path = Path(str(SCOPE["wrapper_execution_receipt_out"])).resolve()
    root = Path(str(SCOPE["attempt_root"])).resolve()
    if root != path and root not in path.parents:
        return
    if path.exists():
        return
    artifacts = {}
    for name in (
        "doctor_receipt_out",
        "geography_precredential_receipt_out",
        "geography_presubmit_receipt_out",
        "result_out",
        "command_receipt_out",
        "user_stream_journal_out",
        "lifecycle_journal_out",
    ):
        candidate = Path(str(SCOPE[name])).resolve()
        if candidate.is_file():
            artifacts[name] = {"path": str(candidate), "sha256": _sha256(candidate)}
    command = None
    command_path = Path(str(SCOPE["command_receipt_out"])).resolve()
    if command_path.is_file():
        try:
            command = json.loads(command_path.read_text(encoding="utf-8-sig"))
        except (OSError, json.JSONDecodeError):
            command = None
    submit_started = False if EXECUTION_PHASE != "stage1_command" else "UNKNOWN"
    journal_path = Path(str(SCOPE["lifecycle_journal_out"])).resolve()
    if journal_path.is_file():
        try:
            submit_started = False
            for line in journal_path.read_text(encoding="utf-8-sig").splitlines():
                row = json.loads(line)
                if row.get("event_type") == "submit_started":
                    submit_started = True
                    break
        except (OSError, json.JSONDecodeError):
            submit_started = "UNKNOWN"
    _atomic_json(
        path,
        {
            "schema_version": "international_live_fixed_scope_execution_v0.7",
            "stage": STAGE_NAME,
            "execution_host_profile": SCOPE["execution_host_profile"],
            "execution_host_id": SCOPE["execution_host_id"],
            "status": status,
            "finished_at_local": datetime.now().astimezone().isoformat(),
            "production_tip": SCOPE["expected_production_tip"],
            "target_date": SCOPE["target_date"],
            "condition_id": SCOPE["condition_id"],
            "token_id": SCOPE["token_id"],
            "requested_budget_pusd": float(SCOPE["requested_budget_pusd"]),
            "cancellation_mode": CANCELLATION_MODE,
            "wrapper": {
                "path": str(Path(__file__).resolve()),
                "sha256": _sha256(Path(__file__).resolve()),
            },
            "phase": EXECUTION_PHASE,
            "confirmation_scope_display_sha256": CONFIRMATION_SCOPE_DISPLAY_SHA256,
            "host_attestations": list(HOST_ATTESTATIONS),
            "credential_values_read_in_memory": (
                command.get("credential_values_read_in_memory", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "live_mutation_attempted": (
                command.get("authenticated_exchange_write_attempted", "UNKNOWN")
                if isinstance(command, dict)
                else (False if EXECUTION_PHASE != "stage1_command" else "UNKNOWN")
            ),
            "order_submit_attempted": submit_started,
            "authenticated_exchange_write_attempted": (
                command.get("authenticated_exchange_write_attempted", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "exception_type": exception_type,
            "artifacts": artifacts,
            "secret_values_redacted": True,
        },
    )


def main() -> int:
    global CONFIRMATION_SCOPE_DISPLAY_SHA256, EXECUTION_PHASE
    if len(sys.argv) != 1:
        raise RuntimeError("fixed-scope Stage 1 wrapper accepts no arguments")
    _assert_sealed()
    _assert_git_and_sources()
    _assert_paths_and_stage0()
    _assert_host_state()

    EXECUTION_PHASE = "sdk_overlay_validation"
    sys.path.insert(0, str(PRODUCTION / "src"))
    from weather.market.live_sdk_overlay import activate_live_sdk_overlay

    sdk_activation = activate_live_sdk_overlay(
        SCOPE["sdk_overlay_manifest_path"],
        SCOPE["sdk_overlay_manifest_sha256"],
    )
    from weather.market import mm_live_pilot_cli as live_cli
    from weather.market.mm_live_lifecycle_probe import (
        verify_stage1_user_stream_journal,
    )
    from weather.market.mm_live_stage0_scope import (
        validate_bound_stage0_event_metadata,
    )
    from weather.market.mm_live_stage1_lifecycle_plan import (
        load_stage1_lifecycle_plan_gate,
    )

    expected_module = (PRODUCTION / "src/weather/market/mm_live_pilot_cli.py").resolve()
    if Path(live_cli.__file__).resolve() != expected_module:
        raise RuntimeError("live pilot module resolved outside the reviewed source")
    doctor_args = SimpleNamespace(
        command="doctor",
        identity=SCOPE["identity_path"],
        target_date=SCOPE["target_date"],
        condition_id=SCOPE["condition_id"],
        token_id=SCOPE["token_id"],
        budget=SCOPE["requested_budget_pusd"],
        receipt_out=SCOPE["doctor_receipt_out"],
        sdk_overlay_activation=sdk_activation,
        confirmation=live_cli.DOCTOR_CONFIRMATION,
    )
    doctor = live_cli.run_doctor(doctor_args)
    if doctor.get("status") != "PASS" or doctor.get("missing"):
        raise RuntimeError("fixed-scope keyless doctor did not pass")
    EXECUTION_PHASE = "supervised_confirmation"
    CONFIRMATION_SCOPE_DISPLAY_SHA256 = _display_confirmation_scope()
    expected_confirmation = "INTERNATIONAL_POLYMARKET_STAGE1_LIFECYCLE_PROBE"
    if _prompt_until(expected_confirmation).strip() != expected_confirmation:
        raise RuntimeError("supervised Stage 1 confirmation did not match")
    _assert_precredential_reserve()
    _assert_window_current()
    _assert_git_and_sources()
    _assert_paths_and_stage0(doctor_may_exist=True)
    _assert_host_state()
    lifecycle_gate = load_stage1_lifecycle_plan_gate(
        SCOPE["candidate_plan_path"],
        SCOPE["target_date"],
        expected_condition_id=SCOPE["condition_id"],
        expected_token_id=SCOPE["token_id"],
    )
    validate_bound_stage0_event_metadata(
        SCOPE["event_metadata_path"],
        lifecycle_gate["event_metadata"],
        target_date=SCOPE["target_date"],
    )
    EXECUTION_PHASE = "stage1_geography_gate"
    _run_geography_check("geography_precredential_receipt_out")
    EXECUTION_PHASE = "stage1_credential_evidence_gate"
    from weather.operations import international_live_wrapper_sealer as evidence

    if Path(evidence.__file__).resolve() != (
        PRODUCTION
        / "src/weather/operations/international_live_wrapper_sealer.py"
    ).resolve():
        raise RuntimeError("credential evidence validator resolved outside reviewed source")
    evidence._validate_credential_import_receipt(
        Path(SCOPE["credential_import_receipt_path"]),
        required_mode=evidence.FIRST_SESSION_CREDENTIAL_MODE,
        now=datetime.now().astimezone(),
    )
    EXECUTION_PHASE = "stage1_command"
    credential_manifest = json.loads(
        Path(SCOPE["credential_reference_manifest_path"]).read_text(
            encoding="utf-8-sig"
        )
    )
    args = SimpleNamespace(
        identity=SCOPE["identity_path"],
        target_date=SCOPE["target_date"],
        condition_id=SCOPE["condition_id"],
        token_id=SCOPE["token_id"],
        budget=SCOPE["requested_budget_pusd"],
        bootstrap=SCOPE["bootstrap_path"],
        candidate_plan=SCOPE["candidate_plan_path"],
        event_metadata=SCOPE["event_metadata_path"],
        cancellation_mode=CANCELLATION_MODE,
        submit_deadline_utc=SCOPE["run_not_after_local"],
        credential_resolution_deadline_utc=SCOPE["run_not_after_local"],
        pre_submit_attestor=_pre_submit_attestor,
        lifecycle_journal=SCOPE["lifecycle_journal_out"],
        result_out=SCOPE["result_out"],
        receipt_out=SCOPE["command_receipt_out"],
        user_stream_journal=SCOPE["user_stream_journal_out"],
        user_stream_ready_timeout_seconds=45.0,
        confirmation=expected_confirmation,
        expected_wallet_address=credential_manifest["wallet_address"],
    )
    receipt = live_cli.run_stage1(args)
    if receipt.get("status") != "PASS" or (receipt.get("cleanup") or {}).get("ok") is not True:
        raise RuntimeError("fixed-scope Stage 1 did not finish with proved cleanup")
    result_path = Path(str(SCOPE["result_out"])).resolve()
    result = json.loads(result_path.read_text(encoding="utf-8-sig"))
    lifecycle_path = Path(str(SCOPE["lifecycle_journal_out"])).resolve()
    stream_path = Path(str(SCOPE["user_stream_journal_out"])).resolve()
    final_stream_evidence = verify_stage1_user_stream_journal(stream_path, result)
    if not all(
        (
            result.get("status") == "PASS",
            result.get("cancellation_mode") == CANCELLATION_MODE,
            result.get("zero_open_orders_verified") is True,
            result.get("zero_positions_verified") is True,
            result.get("no_trade_lifecycle_event_observed") is True,
            result.get("submit_boundary_heartbeat_acknowledged") is True,
            result.get("submit_boundary_market_rules_verified") is True,
            result.get("submit_boundary_geography_before_heartbeat_verified") is True,
            result.get("post_sign_order_placement_boundary_verified") is True,
            result.get("terminal_rest_order_verified") is True,
            result.get("terminal_rest_zero_matched_verified") is True,
            result.get("account_trades_rest_verified") is True,
            result.get("scoped_account_trade_count") == 0,
            result.get("post_cancel_quiescence_seconds") == 2.0,
            result.get("collateral_no_fill_reconciliation_verified") is True,
            len(str(result.get("submit_collateral_snapshot_sha256") or "")) == 64,
            result.get("submit_collateral_snapshot_sha256")
            == result.get("post_cancel_collateral_snapshot_sha256"),
            10 <= float(result.get("submit_collateral_balance_usdc")) <= 100,
            float(result.get("submit_collateral_allowance_usdc")) >= 10,
            result.get("candidate_plan_sha256")
            == str(SCOPE["candidate_plan_sha256"]).lower(),
            result.get("journal_sha256") == _sha256(lifecycle_path),
            Path(str(result.get("user_stream_journal_path") or "")).resolve()
            == stream_path,
            result.get("user_stream_journal_sha256") == _sha256(stream_path),
            result.get("cleanup_final_user_stream_journal_sha256")
            == _sha256(stream_path),
            final_stream_evidence.get("sha256")
            == result.get("user_stream_journal_sha256"),
            final_stream_evidence.get("terminal_stream_stopped_verified") is True,
            type(result.get("user_stream_journal_row_count")) is int,
            result.get("user_stream_journal_row_count")
            == final_stream_evidence.get("row_count"),
            type(result.get("user_stream_scoped_order_event_count")) is int,
            result.get("user_stream_scoped_order_event_count")
            == final_stream_evidence.get("scoped_order_event_count"),
        )
    ):
        raise RuntimeError("fixed-scope Stage 1 result failed host postconditions")
    if CANCELLATION_MODE == "cancel_all" and result.get("cancel_response_present") is not True:
        raise RuntimeError("cancel-all result omitted the explicit cancellation response")
    if CANCELLATION_MODE == "dead_man" and not all(
        (
            result.get("cancel_response_present") is False,
            float(result.get("cancellation_elapsed_seconds")) >= 10,
            float(result.get("cancellation_elapsed_seconds")) <= 15,
        )
    ):
        raise RuntimeError("dead-man result failed the automatic lapse contract")
    EXECUTION_PHASE = "complete"
    _write_execution_receipt("PASS")
    print(json.dumps({"status": "PASS", "stage": STAGE_NAME}, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        exit_code = main()
    except BaseException as exc:
        if _is_fully_sealed():
            try:
                _write_execution_receipt("FAIL", type(exc).__name__)
            except BaseException:
                pass
        print(
            json.dumps(
                {
                    "status": "FAIL",
                    "stage": STAGE_NAME,
                    "exception_type": type(exc).__name__,
                    "secret_values_redacted": True,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        raise SystemExit(1)
    raise SystemExit(exit_code)
