}


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _run(command: list[str], *, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        cwd=PRODUCTION,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode not in allowed:
        raise RuntimeError(f"sealed public preflight exited {result.returncode}")
    return result


def _git(*args: str, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    return _run(["git", "-C", str(PRODUCTION), *args], allowed=allowed)


def _is_fully_sealed() -> bool:
    if not TEMPLATE_SEALED or not isinstance(SCOPE, dict) or not isinstance(
        SOURCE_SHA256, dict
    ):
        return False
    return True


def _assert_sealed() -> None:
    if not _is_fully_sealed():
        raise RuntimeError("fixed-scope Stage 1 template is not sealed")
    if not isinstance(SCOPE["allowed_status_flag_sha256"], list):
        raise RuntimeError("allowed status hashes are not sealed as a list")
    if any(
        SHA256_RE.fullmatch(str(value).lower()) is None
        for value in SCOPE["allowed_status_flag_sha256"]
    ):
        raise RuntimeError("allowed status hashes contain an invalid value")
    condition = str(SCOPE["condition_id"]).lower()
    token = str(SCOPE["token_id"])
    if CONDITION_RE.fullmatch(condition) is None:
        raise RuntimeError("fixed condition id is invalid")
    if not token.isdigit() or int(token) <= 0:
        raise RuntimeError("fixed token id is invalid")
    budget = float(SCOPE["requested_budget_pusd"])
    if budget != 10:
        raise RuntimeError("fixed requested budget is not exactly 10 pUSD")
    if CANCELLATION_MODE not in {"cancel_all", "dead_man"}:
        raise RuntimeError("sealed cancellation mode is invalid")
    _assert_window_current()


def _assert_window_current() -> None:
    start = datetime.fromisoformat(str(SCOPE["run_not_before_local"]))
    stop = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    now = datetime.now().astimezone()
    if start.tzinfo is None or stop.tzinfo is None or not start < stop:
        raise RuntimeError("fixed local run window is invalid")
    if (stop - start).total_seconds() > 30 * 60:
        raise RuntimeError("fixed local run window exceeds 30 minutes")
    if not start <= now <= stop or now.date().isoformat() != SCOPE["target_date"]:
        raise RuntimeError("fixed-scope Stage 1 wrapper is outside its exact window")


def _prompt_until(expected: str) -> str:
    deadline = datetime.fromisoformat(str(SCOPE["run_not_after_local"])) - timedelta(
        seconds=PRE_CREDENTIAL_RESERVE_SECONDS
    )
    sys.stdout.write(f"Type {expected} to continue: ")
    sys.stdout.flush()
    characters: list[str] = []
    while datetime.now().astimezone() < deadline:
        if not msvcrt.kbhit():
            time.sleep(0.05)
            continue
        character = msvcrt.getwch()
        if character in ("\r", "\n"):
            sys.stdout.write("\n")
            sys.stdout.flush()
            return "".join(characters)
        if character == "\x03":
            raise KeyboardInterrupt()
        if character == "\b":
            if characters:
                characters.pop()
                sys.stdout.write("\b \b")
                sys.stdout.flush()
            continue
        if character.isprintable():
            characters.append(character)
            sys.stdout.write(character)
            sys.stdout.flush()
    raise TimeoutError("supervised confirmation expired at the sealed deadline")


def _assert_precredential_reserve() -> None:
    deadline = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    if (deadline - datetime.now().astimezone()).total_seconds() < PRE_CREDENTIAL_RESERVE_SECONDS:
        raise RuntimeError("sealed Stage 1 pre-credential reserve is exhausted")


def _display_confirmation_scope() -> str:
    payload = {
        "stage": STAGE_NAME,
        "cancellation_mode": CANCELLATION_MODE,
        "target_date": SCOPE["target_date"],
        "condition_id": SCOPE["condition_id"],
        "token_id": SCOPE["token_id"],
        "requested_budget_pusd": 10,
        "wallet_cap_pusd": 100,
        "cutoff_local": SCOPE["run_not_after_local"],
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    print(json.dumps({"confirmation_scope": payload}, sort_keys=True))
    return hashlib.sha256(encoded).hexdigest()


def _assert_git_and_sources() -> None:
    if Path(sys.executable).resolve() != PRODUCTION_PYTHON.resolve():
        raise RuntimeError("fixed-scope wrapper is not using the production interpreter")
    head = _git("rev-parse", "HEAD").stdout.strip().lower()
    master = _git("rev-parse", "master").stdout.strip().lower()
    origin = _git("rev-parse", "origin/master").stdout.strip().lower()
    branch = _git("branch", "--show-current").stdout.strip()
    if not (
        head == master == origin == str(SCOPE["expected_production_tip"]).lower()
        and branch == "master"
    ):
        raise RuntimeError("production HEAD/master/origin or branch changed")
    tree = _git("rev-parse", "HEAD^{tree}").stdout.strip().lower()
    if tree != str(SCOPE["expected_production_tree"]).lower():
        raise RuntimeError("production tree changed after wrapper review")
    hardening = _git(
        "merge-base",
        "--is-ancestor",
        HARDENING_TIP,
        head,
        allowed=(0, 1),
    )
    if hardening.returncode != 0:
        raise RuntimeError("interrupt-cleanup hardening is not integrated")
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
        if _git("rev-parse", "-q", "--verify", marker, allowed=(0, 1)).returncode == 0:
            raise RuntimeError("production has an in-progress Git operation")
    dirty = {
        line[3:].replace("\\", "/")
        for line in _git("status", "--porcelain=v1").stdout.splitlines()
        if line.strip()
    }
    if not dirty.issubset(ALLOWED_DIRTY_PATHS):
        raise RuntimeError("production worktree has unexpected changes")
    for relative, expected in SOURCE_SHA256.items():
        path = (PRODUCTION / relative).resolve()
        if not path.is_file() or _sha256(path) != str(expected).lower():
            raise RuntimeError("reviewed live source hash changed")


