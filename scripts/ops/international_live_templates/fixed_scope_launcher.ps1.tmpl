[CmdletBinding()]
param()

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

# The repository sealer replaces every marker. The final launcher has no
# trigger and no runtime scope, secret, budget, or cap inputs.
$repo = "__SEAL_PRODUCTION_ROOT__"
$python = "__SEAL_PRODUCTION_PYTHON__"
$wrapper = "__SEAL_WRAPPER_PATH__"
$expectedWrapperSha256 = "__SEAL_WRAPPER_SHA256__"
$workload = "__SEAL_WORKLOAD__"
$expectedLeaseScriptSha256 = "__SEAL_WORKLOAD_ADMISSION_SHA256__"
$credentialManifest = "__SEAL_CREDENTIAL_MANIFEST_PATH__"
$expectedCredentialManifestSha256 = "__SEAL_CREDENTIAL_MANIFEST_SHA256__"
$leaseScript = Join-Path $repo "scripts\ops\workload_admission.ps1"

function Get-SealedCredentialEnvironment {
    param(
        [Parameter(Mandatory = $true)][string]$ManifestPath,
        [Parameter(Mandatory = $true)][string]$ExpectedSha256
    )
    if (-not (Test-Path -LiteralPath $ManifestPath -PathType Leaf)) {
        throw "credential reference manifest is absent"
    }
    $observed = (Get-FileHash -LiteralPath $ManifestPath -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($observed -ne $ExpectedSha256.ToLowerInvariant()) {
        throw "credential reference manifest hash changed"
    }
    try { $manifest = Get-Content -LiteralPath $ManifestPath -Raw | ConvertFrom-Json }
    catch { throw "credential reference manifest is invalid JSON" }
    $requiredReferences = @(
        "POLYMARKET_API_KEY_STORAGE_REF",
        "POLYMARKET_API_SECRET_STORAGE_REF",
        "POLYMARKET_API_PASSPHRASE_STORAGE_REF",
        "POLYMARKET_PRIVATE_KEY_STORAGE_REF"
    )
    $referenceNames = @($manifest.credential_references.PSObject.Properties.Name | Sort-Object)
    $expectedNames = @($requiredReferences | Sort-Object)
    if (
        [string]$manifest.schema_version -cne "mm_live_credential_reference_manifest_v0.1" -or
        [string]$manifest.platform -cne "polymarket_global" -or
        $manifest.secret_values_retained -ne $false -or
        $referenceNames.Count -ne 4 -or
        @(Compare-Object $expectedNames $referenceNames).Count -ne 0
    ) {
        throw "credential reference manifest contract changed"
    }
    $environment = @{}
    foreach ($name in $requiredReferences) {
        $value = [string]$manifest.credential_references.$name
        if ($value -notmatch '^wincred://[^\s]+$') {
            throw "credential reference manifest contains an invalid public reference"
        }
        $environment[$name] = $value
    }
    $publicNames = @($manifest.public_environment.PSObject.Properties.Name)
    $funder = [string]$manifest.public_environment.POLYMARKET_FUNDER_ADDRESS
    if (
        $publicNames.Count -ne 1 -or
        $publicNames[0] -cne "POLYMARKET_FUNDER_ADDRESS" -or
        $funder -notmatch '^0x[0-9a-fA-F]{40}$' -or
        $funder -ine [string]$manifest.funder_address
    ) {
        throw "credential public environment contract changed"
    }
    $environment["POLYMARKET_FUNDER_ADDRESS"] = $funder
    return $environment
}

function Enter-SealedCredentialEnvironment {
    param([Parameter(Mandatory = $true)][hashtable]$PublicEnvironment)
    $directSecretNames = @(
        "POLYMARKET_API_KEY",
        "POLYMARKET_API_SECRET",
        "POLYMARKET_API_PASSPHRASE",
        "POLYMARKET_PRIVATE_KEY",
        "POLYMARKET_US_SECRET_KEY"
    )
    $allNames = @($PublicEnvironment.Keys) + $directSecretNames
    $prior = @{}
    foreach ($name in $allNames) {
        $prior[$name] = [Environment]::GetEnvironmentVariable($name, "Process")
    }
    try {
        foreach ($name in $directSecretNames) {
            [Environment]::SetEnvironmentVariable($name, $null, "Process")
        }
        foreach ($name in $PublicEnvironment.Keys) {
            [Environment]::SetEnvironmentVariable(
                $name,
                [string]$PublicEnvironment[$name],
                "Process"
            )
        }
    }
    catch {
        foreach ($name in $prior.Keys) {
            [Environment]::SetEnvironmentVariable($name, $prior[$name], "Process")
        }
        throw
    }
    return $prior
}

function Exit-SealedCredentialEnvironment {
    param([Parameter(Mandatory = $true)][hashtable]$PriorEnvironment)
    foreach ($name in $PriorEnvironment.Keys) {
        [Environment]::SetEnvironmentVariable(
            $name,
            $PriorEnvironment[$name],
            "Process"
        )
    }
}

if ($args.Count -ne 0) {
    throw "fixed-scope launcher accepts no arguments"
}
foreach ($path in @($python, $wrapper, $leaseScript, $credentialManifest)) {
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "fixed-scope launcher dependency is absent"
    }
}
$observedWrapperHash = (Get-FileHash -LiteralPath $wrapper -Algorithm SHA256).Hash.ToLowerInvariant()
if ($observedWrapperHash -ne $expectedWrapperSha256) {
    throw "fixed-scope wrapper hash changed"
}
$observedLeaseHash = (Get-FileHash -LiteralPath $leaseScript -Algorithm SHA256).Hash.ToLowerInvariant()
if ($observedLeaseHash -ne $expectedLeaseScriptSha256) {
    throw "workload-admission source hash changed"
}
$sealedCredentialEnvironment = Get-SealedCredentialEnvironment `
    -ManifestPath $credentialManifest `
    -ExpectedSha256 $expectedCredentialManifestSha256

. $leaseScript
$lease = $null
$priorCredentialEnvironment = $null
$exitCode = 1
try {
    $lease = Enter-WeatherHeavyWorkloadLease -RepoRoot $repo -Workload $workload
    if ($null -eq $lease) {
        throw "shared workload lease is busy"
    }
    $priorCredentialEnvironment = Enter-SealedCredentialEnvironment `
        -PublicEnvironment $sealedCredentialEnvironment
    & $python $wrapper
    $exitCode = $LASTEXITCODE
}
finally {
    if ($null -ne $priorCredentialEnvironment) {
        Exit-SealedCredentialEnvironment -PriorEnvironment $priorCredentialEnvironment
    }
    if ($null -ne $lease) {
        Exit-WeatherHeavyWorkloadLease -Lease $lease
    }
}
if ($exitCode -ne 0) {
    Write-Error "fixed-scope wrapper failed with exit $exitCode" -ErrorAction Continue
}
exit $exitCode
