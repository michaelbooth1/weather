[CmdletBinding()]
param()

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$repo = "__SESSION_REPO_ROOT__"
$python = "__SESSION_PYTHON__"
$expectedPythonSha256 = "__SESSION_PYTHON_SHA256__"
$runnerSource = "__SESSION_RUNNER_SOURCE__"
$expectedRunnerSha256 = "__SESSION_RUNNER_SHA256__"
$manifest = "__SESSION_MANIFEST__"
$expectedManifestSha256 = "__SESSION_MANIFEST_SHA256__"
$candidate = "__SESSION_CANDIDATE_INBOX__"
$manifestSidecar = "__SESSION_MANIFEST_SIDECAR__"
$expectedManifestSidecarSha256 = "__SESSION_MANIFEST_SIDECAR_SHA256__"
$manifestBuildReceipt = "__SESSION_MANIFEST_BUILD_RECEIPT__"
$expectedManifestBuildReceiptSha256 = "__SESSION_MANIFEST_BUILD_RECEIPT_SHA256__"
$jobScriptRelative = "scripts/ops/windows_kill_on_close_job.ps1"
$jobScript = Join-Path $repo $jobScriptRelative
$expectedJobScriptSha256 = "__SESSION_WINDOWS_JOB_HELPER_SHA256__"
$venvRoot = Split-Path -Parent (Split-Path -Parent $python)
$sitePackages = Join-Path $venvRoot "Lib\site-packages"

if ($MyInvocation.UnboundArguments.Count -ne 0) {
    throw "fixed session launcher accepts no arguments"
}
foreach ($path in @(
    $python,
    $runnerSource,
    $manifest,
    $manifestSidecar,
    $manifestBuildReceipt,
    $candidate,
    $jobScript
)) {
    if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
        throw "fixed session launcher dependency is absent"
    }
}
if (-not (Test-Path -LiteralPath $sitePackages -PathType Container) -or
    ((Get-Item -LiteralPath $sitePackages -Force).Attributes -band
        [IO.FileAttributes]::ReparsePoint) -ne 0) {
    throw "fixed session site-packages directory is absent or redirected"
}
function Add-LockedExactFile {
    param([string]$Path, [AllowNull()][string]$ExpectedSha256)
    $stream = $null
    try {
        $stream = [IO.File]::Open(
            $Path,
            [IO.FileMode]::Open,
            [IO.FileAccess]::Read,
            [IO.FileShare]::Read
        )
        if (-not [string]::IsNullOrEmpty($ExpectedSha256)) {
            $hasher = [Security.Cryptography.SHA256]::Create()
            try {
                $observed = -join ($hasher.ComputeHash($stream) | ForEach-Object { $_.ToString("x2") })
            }
            finally { $hasher.Dispose() }
            $stream.Position = 0
            if ($observed -ne $ExpectedSha256) {
                throw "fixed session locked-file hash changed"
            }
        }
        [void]$lockedFiles.Add($stream)
        $stream = $null
    }
    finally {
        if ($null -ne $stream) { $stream.Dispose() }
    }
}

$lockedFiles = [Collections.Generic.List[IDisposable]]::new()
$priorFixedSessionSrc = $env:WEATHER_FIXED_SESSION_SRC
$priorFixedSessionSitePackages = $env:WEATHER_FIXED_SESSION_SITE_PACKAGES
$priorPSModulePath = $env:PSModulePath
try {
    Add-LockedExactFile -Path $python -ExpectedSha256 $expectedPythonSha256
    Add-LockedExactFile -Path $runnerSource -ExpectedSha256 $expectedRunnerSha256
    Add-LockedExactFile -Path $manifest -ExpectedSha256 $expectedManifestSha256
    Add-LockedExactFile -Path $manifestSidecar -ExpectedSha256 $expectedManifestSidecarSha256
    Add-LockedExactFile -Path $manifestBuildReceipt -ExpectedSha256 $expectedManifestBuildReceiptSha256
    $manifestPayload = Get-Content -LiteralPath $manifest -Raw | ConvertFrom-Json
    if ([string]$manifestPayload.production_python_sha256 -cne $expectedPythonSha256) {
        throw "session manifest interpreter hash differs from launcher review"
    }
    Add-LockedExactFile `
        -Path ([string]$manifestPayload.production.git_executable) `
        -ExpectedSha256 ([string]$manifestPayload.production.git_executable_sha256).ToLowerInvariant()
    foreach ($property in $manifestPayload.session_bootstrap_sha256.psobject.Properties) {
        Add-LockedExactFile `
            -Path (Join-Path $repo $property.Name) `
            -ExpectedSha256 ([string]$property.Value).ToLowerInvariant()
    }
    Add-LockedExactFile `
        -Path $jobScript `
        -ExpectedSha256 $expectedJobScriptSha256
    foreach ($property in $manifestPayload.source_sha256.psobject.Properties) {
        if ([string]$property.Name -ieq $jobScriptRelative) { continue }
        Add-LockedExactFile `
            -Path (Join-Path $repo $property.Name) `
            -ExpectedSha256 ([string]$property.Value).ToLowerInvariant()
    }
    foreach ($property in $manifestPayload.inputs.psobject.Properties) {
        Add-LockedExactFile `
            -Path ([string]$property.Value.path) `
            -ExpectedSha256 ([string]$property.Value.sha256).ToLowerInvariant()
    }
    $attemptRoot = [string]$manifestPayload.scope.attempt_root
    foreach ($existing in Get-ChildItem -LiteralPath $attemptRoot -File -Recurse -Force) {
        if ($lockedFiles.Count -eq 0 -or $existing.FullName -notin @(
            $lockedFiles | ForEach-Object { $_.Name }
        )) {
            Add-LockedExactFile -Path $existing.FullName -ExpectedSha256 $null
        }
    }
    $env:WEATHER_FIXED_SESSION_SRC = Join-Path $repo "src"
    $env:WEATHER_FIXED_SESSION_SITE_PACKAGES = $sitePackages
    $windowsPowerShellModules = Join-Path `
        ([Environment]::GetFolderPath([Environment+SpecialFolder]::Windows)) `
        "System32\WindowsPowerShell\v1.0\Modules"
    if (-not [IO.Directory]::Exists($windowsPowerShellModules) -or
        (([IO.DirectoryInfo]::new($windowsPowerShellModules)).Attributes -band
            [IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "canonical Windows PowerShell module directory is absent or redirected"
    }
    [Environment]::SetEnvironmentVariable(
        "PSModulePath",
        $windowsPowerShellModules,
        "Process"
    )
    . $jobScript
    $job = $null
    $child = $null
    $jobTeardownError = $null
    try {
        $job = New-WeatherKillOnCloseJob
        $runnerArguments = ConvertTo-WeatherWindowsArgumentString -Tokens @(
            "-I",
            "-S",
            "-B",
            "-c",
            "import os,runpy,sys;sys.dont_write_bytecode=True;sys.path.insert(0,os.environ['WEATHER_FIXED_SESSION_SRC']);sys.path.append(os.environ['WEATHER_FIXED_SESSION_SITE_PACKAGES']);runpy.run_module('weather.operations.international_live_session_runner',run_name='__main__')",
            "--session-manifest",
            $manifest,
            "--expected-session-manifest-sha256",
            $expectedManifestSha256,
            "--candidate",
            $candidate
        )
        $child = Start-WeatherInteractiveProcessInJob `
            -Job $job `
            -FilePath $python `
            -ArgumentString $runnerArguments `
            -WorkingDirectory $repo
        $child.WaitForExit()
        $exitCode = [int]$child.ExitCode
    }
    finally {
        if ($null -ne $job) {
            try { $job.TerminateAndWait(5000) }
            catch { $jobTeardownError = $_ }
        }
        if ($null -ne $child) { $child.Dispose() }
        if ($null -ne $job) { $job.Dispose() }
        if ($null -ne $jobTeardownError) { throw $jobTeardownError }
    }
}
finally {
    for ($index = $lockedFiles.Count - 1; $index -ge 0; $index--) {
        $lockedFiles[$index].Dispose()
    }
    if ($null -eq $priorFixedSessionSrc) {
        Remove-Item Env:WEATHER_FIXED_SESSION_SRC -ErrorAction SilentlyContinue
    }
    else { $env:WEATHER_FIXED_SESSION_SRC = $priorFixedSessionSrc }
    if ($null -eq $priorFixedSessionSitePackages) {
        Remove-Item Env:WEATHER_FIXED_SESSION_SITE_PACKAGES -ErrorAction SilentlyContinue
    }
    else {
        $env:WEATHER_FIXED_SESSION_SITE_PACKAGES = $priorFixedSessionSitePackages
    }
    if ($null -eq $priorPSModulePath) {
        Remove-Item Env:PSModulePath -ErrorAction SilentlyContinue
    }
    else { $env:PSModulePath = $priorPSModulePath }
}
exit $exitCode
