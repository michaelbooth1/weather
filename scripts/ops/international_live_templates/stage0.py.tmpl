def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _current_execution_host_id() -> str:
    try:
        with winreg.OpenKey(
            winreg.HKEY_LOCAL_MACHINE,
            r"SOFTWARE\Microsoft\Cryptography",
            access=winreg.KEY_READ | winreg.KEY_WOW64_64KEY,
        ) as key:
            machine, value_type = winreg.QueryValueEx(key, "MachineGuid")
    except OSError as exc:
        raise RuntimeError("execution host identity is unavailable") from exc
    if value_type != winreg.REG_SZ or not str(machine).strip():
        raise RuntimeError("execution host identity is unavailable")
    material = "\0".join((EXECUTION_HOST_ID_DOMAIN, str(machine).strip().casefold()))
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def _run(command: list[str], *, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        cwd=PRODUCTION,
        text=True,
        capture_output=True,
        check=False,
        timeout=10,
    )
    if result.returncode not in allowed:
        raise RuntimeError(f"sealed public preflight exited {result.returncode}")
    return result


def _git(*args: str, allowed=(0,)) -> subprocess.CompletedProcess[str]:
    environment = {
        key: value
        for key, value in os.environ.items()
        if not key.upper().startswith("GIT_")
        and key.upper()
        not in {
            "ALL_PROXY", "CURL_CA_BUNDLE", "HTTP_PROXY", "HTTPS_PROXY",
            "NO_PROXY", "REQUESTS_CA_BUNDLE", "SSL_CERT_DIR", "SSL_CERT_FILE",
            "WEATHER_MARKET_REGISTRY",
        }
    }
    environment.update(
        {
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_OPTIONAL_LOCKS": "0",
            "GCM_INTERACTIVE": "Never",
        }
    )
    command = [
        str(SCOPE["git_executable"]),
        "-c",
        "credential.helper=",
        "-c",
        "credential.interactive=false",
        "-c",
        f"core.hooksPath={os.devnull}",
        "-C",
        str(PRODUCTION),
        *args,
    ]
    result = subprocess.run(
        command,
        cwd=PRODUCTION,
        env=environment,
        text=True,
        capture_output=True,
        check=False,
        timeout=10,
    )
    if result.returncode not in allowed:
        raise RuntimeError(f"sealed Git preflight exited {result.returncode}")
    return result


def _is_fully_sealed() -> bool:
    if not TEMPLATE_SEALED or not isinstance(SCOPE, dict) or not isinstance(
        SOURCE_SHA256, dict
    ):
        return False
    return True


def _assert_sealed() -> None:
    if not _is_fully_sealed():
        raise RuntimeError("fixed-scope Stage 0 template is not sealed")
    if not isinstance(SCOPE["allowed_status_flag_sha256"], list):
        raise RuntimeError("allowed status hashes are not sealed as a list")
    if any(
        SHA256_RE.fullmatch(str(value).lower()) is None
        for value in SCOPE["allowed_status_flag_sha256"]
    ):
        raise RuntimeError("allowed status hashes contain an invalid value")
    profile = str(SCOPE.get("execution_host_profile") or "")
    if profile not in {
        CAPTURE_COLOCATED_HOST_PROFILE,
        PORTABLE_EXECUTION_HOST_PROFILE,
    }:
        raise RuntimeError("execution host profile is invalid")
    expected_branch = str(SCOPE.get("expected_production_branch") or "")
    expected_remote_ref = str(SCOPE.get("expected_remote_branch_ref") or "")
    if (
        profile == CAPTURE_COLOCATED_HOST_PROFILE
        and expected_branch != "master"
    ) or (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and expected_branch not in {"master", PORTABLE_TOPIC_BRANCH}
    ) or expected_remote_ref != f"refs/heads/{expected_branch}":
        raise RuntimeError("sealed production branch is invalid for the host profile")
    if (
        SHA256_RE.fullmatch(str(SCOPE.get("execution_host_id") or "").lower())
        is None
        or str(SCOPE["execution_host_id"]).lower()
        != _current_execution_host_id()
    ):
        raise RuntimeError("wrapper is sealed for a different execution host")
    if (
        SHA256_RE.fullmatch(
            str(SCOPE.get("git_executable_sha256") or "").lower()
        )
        is None
        or not Path(str(SCOPE.get("git_executable") or "")).is_absolute()
        or SCOPE.get("canonical_origin_url")
        != "https://github.com/michaelbooth1/weather.git"
    ):
        raise RuntimeError("sealed Git trust binding is invalid")
    if (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and SCOPE["allowed_status_flag_sha256"]
    ):
        raise RuntimeError("portable execution host has capture status exceptions")
    try:
        market_timezone = ZoneInfo(str(SCOPE.get("market_timezone") or ""))
    except Exception as exc:
        raise RuntimeError("sealed market timezone is invalid") from exc
    if not str(SCOPE.get("market_id") or "").strip() or not market_timezone:
        raise RuntimeError("sealed market calendar binding is invalid")
    condition = str(SCOPE["condition_id"]).lower()
    token = str(SCOPE["token_id"])
    if CONDITION_RE.fullmatch(condition) is None:
        raise RuntimeError("fixed condition id is invalid")
    if not token.isdigit() or int(token) <= 0:
        raise RuntimeError("fixed token id is invalid")
    budget = float(SCOPE["requested_budget_pusd"])
    if budget != 10:
        raise RuntimeError("fixed requested budget is not exactly 10 pUSD")
    _assert_window_current()


def _assert_window_current() -> None:
    start = datetime.fromisoformat(str(SCOPE["run_not_before_local"]))
    stop = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    now = datetime.now().astimezone()
    cleanup_reserve = SCOPE.get("cleanup_reserve_seconds")
    if start.tzinfo is None or stop.tzinfo is None or not start < stop:
        raise RuntimeError("fixed local run window is invalid")
    if (
        isinstance(cleanup_reserve, bool)
        or not isinstance(cleanup_reserve, int)
        or cleanup_reserve <= 0
    ):
        raise RuntimeError("fixed cleanup reserve is invalid")
    if (stop - start).total_seconds() > 30 * 60:
        raise RuntimeError("fixed local run window exceeds 30 minutes")
    calendar_timezone = (
        LIVE_WINDOW_TIMEZONE
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        else ZoneInfo(SCOPE["market_timezone"])
    )
    local_start = start.astimezone(calendar_timezone)
    local_stop = stop.astimezone(calendar_timezone)
    local_contained_end = (
        stop + timedelta(seconds=cleanup_reserve)
    ).astimezone(calendar_timezone)
    start_wall = (
        local_start.hour,
        local_start.minute,
        local_start.second,
        local_start.microsecond,
    )
    contained_end_wall = (
        local_contained_end.hour,
        local_contained_end.minute,
        local_contained_end.second,
        local_contained_end.microsecond,
    )
    execution_date = local_start.date()
    execution_dates_match = (
        local_stop.date() == execution_date
        and local_contained_end.date() == execution_date
    )
    capture_target_date_matches = (
        execution_date.isoformat() == SCOPE["target_date"]
    )
    portable_target_date_matches = SCOPE["target_date"] in {
        execution_date.isoformat(),
        (execution_date + timedelta(days=1)).isoformat(),
    }
    profile_date_matches = (
        capture_target_date_matches
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        else portable_target_date_matches
    )
    colocated_window_matches = (
        start_wall >= LIVE_WINDOW_START
        and contained_end_wall <= LIVE_WINDOW_END
    )
    if not execution_dates_match or not profile_date_matches or (
        SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE
        and not colocated_window_matches
    ):
        if SCOPE["execution_host_profile"] == CAPTURE_COLOCATED_HOST_PROFILE:
            raise RuntimeError(
                "fixed execution plus cleanup reserve is outside the supported "
                "00:30-09:00 America/Toronto live window"
            )
        raise RuntimeError(
            "fixed portable execution requires one local execution date and "
            "a current-day or next-day market target"
        )
    if not start <= now <= stop or (
        now.astimezone(calendar_timezone).date() != execution_date
    ):
        raise RuntimeError("fixed-scope Stage 0 wrapper is outside its exact window")


def _assert_attended_invocation() -> None:
    from weather.execution_host import current_execution_session_id

    if current_execution_session_id() == 0:
        raise RuntimeError("run the reviewed command from the signed-in Windows desktop")


def _assert_reserve(reserve_seconds: int, *, label: str) -> None:
    deadline = datetime.fromisoformat(str(SCOPE["run_not_after_local"]))
    if (deadline - datetime.now().astimezone()).total_seconds() < reserve_seconds:
        raise RuntimeError(f"sealed Stage 0 {label} reserve is exhausted")


def _assert_precredential_reserve() -> None:
    _assert_reserve(PRE_CREDENTIAL_RESERVE_SECONDS, label="pre-credential")


def _assert_mutation_reserve() -> None:
    _assert_reserve(PRE_MUTATION_RESERVE_SECONDS, label="pre-mutation")


def _display_confirmation_scope() -> str:
    from weather.market.mm_pilot_capital import capital_declaration, pilot_capital_limit

    identity = json.loads(Path(str(SCOPE["identity_path"])).read_text(encoding="utf-8-sig"))
    capital_limit = pilot_capital_limit(identity, require_wallet_declaration=True)
    contained_end = datetime.fromisoformat(
        str(SCOPE["run_not_after_local"])
    ) + timedelta(seconds=SCOPE["cleanup_reserve_seconds"])
    payload = {
        "authorization_method": "reviewed_command_invocation",
        "physical_location_eligible": True,
        "no_circumvention": True,
        "stage": "stage0",
        "cancellation_mode": "not_applicable",
        "target_date": SCOPE["target_date"],
        "condition_id": SCOPE["condition_id"],
        "token_id": SCOPE["token_id"],
        "requested_budget_pusd": 10,
        "pilot_capital_limit_pusd": float(capital_limit),
        **capital_declaration(identity),
        "order_submit_expected": False,
        "authenticated_heartbeat_write_expected": True,
        "cancel_all_cleanup_expected": True,
        "cancel_all_scope": "ACCOUNT_WIDE",
        "cutoff_local": SCOPE["run_not_after_local"],
        "cleanup_reserve_seconds": SCOPE["cleanup_reserve_seconds"],
        "contained_process_end_local": contained_end.isoformat(),
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    print(json.dumps({"confirmation_scope": payload}, sort_keys=True))
    return hashlib.sha256(encoded).hexdigest()


def _assert_git_and_sources() -> None:
    from weather.operations.live_path_security import (
        assert_no_ambient_proxy_configuration,
    )

    assert_no_ambient_proxy_configuration()
    if Path(sys.executable).resolve() != PRODUCTION_PYTHON.resolve():
        raise RuntimeError("fixed-scope wrapper is not using the production interpreter")
    git_executable = Path(str(SCOPE["git_executable"]))
    if (
        not git_executable.is_file()
        or _sha256(git_executable)
        != str(SCOPE["git_executable_sha256"]).lower()
    ):
        raise RuntimeError("sealed Git executable changed")
    origin_url = _git(
        "config", "--local", "--get", "remote.origin.url"
    ).stdout.strip()
    push_url = _git(
        "config",
        "--local",
        "--get-all",
        "remote.origin.pushurl",
        allowed=(0, 1),
    ).stdout.strip()
    config_names = _git(
        "config", "--local", "--name-only", "--list"
    ).stdout.splitlines()
    forbidden_prefixes = (
        "url.", "include.", "includeif.", "http.", "credential.",
        "core.sshcommand", "remote.origin.proxy",
    )
    if (
        origin_url != SCOPE["canonical_origin_url"]
        or push_url
        or any(
            name.casefold().startswith(forbidden_prefixes)
            for name in config_names
        )
    ):
        raise RuntimeError("production Git remote or trust configuration changed")
    profile = str(SCOPE["execution_host_profile"])
    selected_branch = str(SCOPE["expected_production_branch"])
    if (
        profile == CAPTURE_COLOCATED_HOST_PROFILE
        and selected_branch != "master"
    ) or (
        profile == PORTABLE_EXECUTION_HOST_PROFILE
        and selected_branch not in {"master", PORTABLE_TOPIC_BRANCH}
    ):
        raise RuntimeError("sealed production branch is invalid for the host profile")
    selected_local_ref = f"refs/heads/{selected_branch}"
    selected_cached_ref = f"refs/remotes/origin/{selected_branch}"
    selected_remote_ref = str(SCOPE["expected_remote_branch_ref"])
    if selected_remote_ref != selected_local_ref:
        raise RuntimeError("sealed remote branch ref does not match the selected branch")
    master_remote_ref = "refs/heads/master"
    head = _git("rev-parse", "HEAD").stdout.strip().lower()
    local_selected = _git("rev-parse", selected_local_ref).stdout.strip().lower()
    cached_selected = _git("rev-parse", selected_cached_ref).stdout.strip().lower()
    master = _git("rev-parse", "refs/heads/master").stdout.strip().lower()
    cached_master = _git(
        "rev-parse", "refs/remotes/origin/master"
    ).stdout.strip().lower()
    branch = _git("branch", "--show-current").stdout.strip()
    required_remote_refs = sorted({master_remote_ref, selected_remote_ref})
    assert_no_ambient_proxy_configuration()
    remote_result = _git(
        "ls-remote",
        "--exit-code",
        "--refs",
        SCOPE["canonical_origin_url"],
        *required_remote_refs,
    )
    assert_no_ambient_proxy_configuration()
    remote_rows = [
        line.split()
        for line in remote_result.stdout.splitlines()
        if line.strip()
    ]
    remote_by_ref = {}
    for row in remote_rows:
        if (
            len(row) != 2
            or row[1] not in required_remote_refs
            or row[1] in remote_by_ref
            or GIT_OID_RE.fullmatch(row[0].lower()) is None
        ):
            raise RuntimeError("live origin ref proof is malformed or unavailable")
        remote_by_ref[row[1]] = row[0].lower()
    if set(remote_by_ref) != set(required_remote_refs):
        raise RuntimeError("live origin ref proof is malformed or unavailable")
    remote_master = remote_by_ref[master_remote_ref]
    remote_selected = remote_by_ref[selected_remote_ref]
    if not (
        head
        == local_selected
        == cached_selected
        == remote_selected
        == str(SCOPE["expected_production_tip"]).lower()
        and master == cached_master == remote_master
        and branch == selected_branch
    ):
        raise RuntimeError("production selected ref, master baseline, or branch changed")
    base_ancestry = _git(
        "merge-base",
        "--is-ancestor",
        remote_master,
        head,
        allowed=(0, 1),
    )
    if base_ancestry.returncode != 0:
        raise RuntimeError("live origin master is not an ancestor of the selected tip")
    tree = _git("rev-parse", "HEAD^{tree}").stdout.strip().lower()
    if tree != str(SCOPE["expected_production_tree"]).lower():
        raise RuntimeError("production tree changed after wrapper review")
    hardening = _git(
        "merge-base",
        "--is-ancestor",
        HARDENING_TIP,
        head,
        allowed=(0, 1),
    )
    if hardening.returncode != 0:
        raise RuntimeError("interrupt-cleanup hardening is not integrated")
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD"):
        if _git("rev-parse", "-q", "--verify", marker, allowed=(0, 1)).returncode == 0:
            raise RuntimeError("production has an in-progress Git operation")
    dirty = {
        line[3:].replace("\\", "/")
        for line in _git("status", "--porcelain=v1").stdout.splitlines()
        if line.strip()
    }
    execution_profile = str(SCOPE["execution_host_profile"])
    worktree_policy_clean = (
        not dirty
        if execution_profile == "portable_execution_v1"
        else dirty.issubset(ALLOWED_DIRTY_PATHS)
    )
    if not worktree_policy_clean:
        raise RuntimeError("production worktree has unexpected changes")
    for relative, expected in SOURCE_SHA256.items():
        path = (PRODUCTION / relative).resolve()
        if not path.is_file() or _sha256(path) != str(expected).lower():
            raise RuntimeError("reviewed live source hash changed")


def _assert_paths(*, doctor_may_exist: bool = False) -> None:
    root = Path(str(SCOPE["attempt_root"])).resolve()
    inputs = {
        "identity": (
            Path(str(SCOPE["identity_path"])).resolve(),
            str(SCOPE["identity_sha256"]).lower(),
        ),
        "scope_plan": (
            Path(str(SCOPE["scope_plan_path"])).resolve(),
            str(SCOPE["scope_plan_sha256"]).lower(),
        ),
        "event_metadata": (
            Path(str(SCOPE["event_metadata_path"])).resolve(),
            str(SCOPE["event_metadata_sha256"]).lower(),
        ),
        "credential_import_receipt": (
            Path(str(SCOPE["credential_import_receipt_path"])).resolve(),
            str(SCOPE["credential_import_receipt_sha256"]).lower(),
        ),
        "credential_reference_manifest": (
            Path(str(SCOPE["credential_reference_manifest_path"])).resolve(),
            str(SCOPE["credential_reference_manifest_sha256"]).lower(),
        ),
    }
    output_names = (
        "doctor_receipt_out",
        "geography_precredential_receipt_out",
        "geography_premutation_receipt_out",
        "bootstrap_out",
        "command_receipt_out",
        "user_stream_journal_out",
        "wrapper_execution_receipt_out",
    )
    outputs = {
        name: Path(str(SCOPE[name])).resolve()
        for name in output_names
    }
    all_paths = [path for path, _expected in inputs.values()] + list(outputs.values())
    if len(all_paths) != len(set(all_paths)):
        raise RuntimeError("fixed input/output paths are not distinct")
    external_inputs = {
        inputs["credential_import_receipt"][0],
        inputs["credential_reference_manifest"][0],
    }
    for path in all_paths:
        if path in external_inputs:
            continue
        if root != path and root not in path.parents:
            raise RuntimeError("fixed path escapes the reviewed attempt root")
    for path, expected in inputs.values():
        if (
            not path.is_file()
            or SHA256_RE.fullmatch(expected) is None
            or _sha256(path) != expected
        ):
            raise RuntimeError("fixed Stage 0 input is absent or hash-mismatched")
    if any(
        path.exists()
        for name, path in outputs.items()
        if not (doctor_may_exist and name == "doctor_receipt_out")
    ):
        raise RuntimeError("fixed Stage 0 output path already exists")


def _assert_host_state() -> None:
    _assert_window_current()
    from weather.operations.live_path_security import (
        LivePathSecurityError,
        canonical_windows_powershell,
        validate_launcher_lease_process_lineage,
    )

    powershell = canonical_windows_powershell()
    portable = (
        SCOPE["execution_host_profile"] == PORTABLE_EXECUTION_HOST_PROFILE
    )
    status_script = (
        "international_live_execution_host_status.ps1"
        if portable
        else "status.ps1"
    )
    status_result = _run(
        [
            str(powershell),
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            str(PRODUCTION / "scripts" / "ops" / status_script),
            "-Json",
            "-RepoRoot",
            str(PRODUCTION),
        ],
        allowed=(0, 2),
    )
    status = json.loads(status_result.stdout)
    observed_flag_hashes = sorted(
        hashlib.sha256(str(flag).encode("utf-8")).hexdigest()
        for flag in status.get("flags") or []
    )
    if observed_flag_hashes != sorted(SCOPE["allowed_status_flag_sha256"]):
        raise RuntimeError("execution host status flags differ from the sealed set")
    if portable:
        if (
            status_result.returncode != 0
            or status.get("status") != "PASS"
            or status.get("flags") != []
            or status.get("schema_version")
            != "international_live_execution_host_status_v0.3"
            or status.get("execution_host_id") != SCOPE["execution_host_id"]
            or SHA256_RE.fullmatch(
                str(status.get("execution_principal_id") or "").lower()
            )
            is None
            or (status.get("execution_host_assignment") or {}).get(
                "current_assignment_matches"
            )
            is not True
            or Path(str(status.get("repository_root") or "")).resolve()
            != PRODUCTION.resolve()
            or status.get("credential_access") is not False
            or status.get("exchange_contact") is not False
            or status.get("scheduler_mutation") is not False
            or status.get("capture_mutation") is not False
        ):
            raise RuntimeError("portable execution host status contract changed")
    else:
        today = str((status.get("streak") or {}).get("today") or "")
        if not (today.startswith("ON_TRACK") or today.startswith("CLEAN")):
            raise RuntimeError("capture day is not healthy")
        runtime = status.get("capture_runtime") or {}
        if not CORE_WORKERS.issubset(runtime):
            raise RuntimeError("core capture runtime status is incomplete")
        if any(
            runtime[name].get("parsed") is not True
            or runtime[name].get("consecutive_errors") != 0
            or runtime[name].get("last_error_present") is True
            for name in CORE_WORKERS
        ):
            raise RuntimeError("core capture has an unclean current state")
        tape = status.get("execution_tape") or {}
        if not all(
            (
                tape.get("armed") is True,
                tape.get("process_healthy") is True,
                tape.get("capture_state") == "CONNECTED",
                tape.get("evidence_integrity") == "PASS",
                float(tape.get("heartbeat_age_seconds")) <= 15,
            )
        ):
            raise RuntimeError("public execution capture is not healthy")
    clock = status.get("clock") or {}
    if (
        clock.get("synchronized") is not True
        or clock.get("sync_age_hours") is None
        or not 0 <= float(clock["sync_age_hours"]) <= 24
    ):
        raise RuntimeError("host clock is not synchronized")
    if (status.get("resilience") or {}).get("reboot_pending") is not False:
        raise RuntimeError("host has a pending reboot")
    lock_path = PRODUCTION / "data" / "logs" / "heavy_workload.lock"
    try:
        owner = json.loads(lock_path.read_text(encoding="utf-8-sig"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError("fixed-scope launcher lease record is unavailable") from exc
    try:
        owner_pid = int(owner.get("pid"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("fixed-scope launcher lease owner is invalid") from exc
    if not (
        owner.get("schema_version") == "weather_heavy_workload_lease_v3"
        and owner.get("workload") == SCOPE["expected_lease_workload"]
        and str(owner.get("owner_process_creation_time_token") or "").startswith(
            "win32-filetime:"
        )
        and owner.get("execution_host_profile")
        == SCOPE["execution_host_profile"]
        and owner.get("execution_host_id") == SCOPE["execution_host_id"]
        and (
            SCOPE["execution_host_profile"] != PORTABLE_EXECUTION_HOST_PROFILE
            or owner.get("execution_principal_id")
            == status.get("execution_principal_id")
        )
    ):
        raise RuntimeError("fixed-scope wrapper does not own the shared launcher lease")
    try:
        lease_process_lineage = validate_launcher_lease_process_lineage(
            lease_owner_pid=owner_pid,
            lease_path=lock_path,
            expected_owner_creation_time_token=owner[
                "owner_process_creation_time_token"
            ],
            expected_owner_executable=powershell,
            expected_pyvenv_config=PRODUCTION_PYVENV_CONFIG,
            expected_pyvenv_config_sha256=PRODUCTION_PYVENV_CONFIG_SHA256,
            expected_redirector_executable=PRODUCTION_PYTHON,
            expected_redirector_sha256=PRODUCTION_PYTHON_SHA256,
            expected_runtime_executable=PRODUCTION_RUNTIME_PYTHON,
            expected_runtime_sha256=PRODUCTION_RUNTIME_PYTHON_SHA256,
        )
    except LivePathSecurityError as exc:
        raise RuntimeError(
            "fixed-scope wrapper does not own the shared launcher lease"
        ) from exc
    HOST_ATTESTATIONS.append(
        {
            "checked_at_local": datetime.now().astimezone().isoformat(),
            "status_json_sha256": hashlib.sha256(
                status_result.stdout.encode("utf-8")
            ).hexdigest(),
            "status_flag_sha256": observed_flag_hashes,
            "execution_host_profile": SCOPE["execution_host_profile"],
            "execution_host_id": SCOPE["execution_host_id"],
            "lease_process_lineage": lease_process_lineage,
        }
    )


def _atomic_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())


def _run_geography_check(output_name: str) -> dict:
    from weather.market import mm_geographic_eligibility as geography
    from weather.operations.live_path_security import (
        assert_no_ambient_proxy_configuration,
    )

    expected_module = (
        PRODUCTION / "src/weather/market/mm_geographic_eligibility.py"
    ).resolve()
    if Path(geography.__file__).resolve() != expected_module:
        raise RuntimeError("geographic eligibility module resolved outside reviewed source")
    reserve_seconds = {
        "geography_precredential_receipt_out": PRE_CREDENTIAL_RESERVE_SECONDS,
        "geography_premutation_receipt_out": PRE_MUTATION_RESERVE_SECONDS,
    }.get(output_name)
    if reserve_seconds is None:
        raise RuntimeError("unsupported Stage 0 geography boundary")
    confirmation = geography.PHYSICAL_LOCATION_CONFIRMATION
    # The reviewed local command supplies the operator attestation once.
    # Repeat the official geographic check at each action boundary, without input.
    _assert_reserve(reserve_seconds, label="geography")
    assert_no_ambient_proxy_configuration()
    receipt = geography.check_geographic_eligibility(
        SCOPE[output_name],
        confirmation=confirmation,
        physical_location_eligible=True,
        no_circumvention=True,
    )
    assert_no_ambient_proxy_configuration()
    if receipt.get("status") != "PASS" or receipt.get("eligible") is not True:
        raise RuntimeError("geographic eligibility did not pass exactly")
    if output_name == "geography_precredential_receipt_out":
        _assert_precredential_reserve()
    else:
        _assert_mutation_reserve()
    return receipt


def _run_premutation_geography_check() -> dict:
    global EXECUTION_PHASE
    EXECUTION_PHASE = "stage0_premutation_geography_gate"
    _assert_host_state()
    return _run_geography_check("geography_premutation_receipt_out")


def _write_execution_receipt(status: str, exception_type: str | None = None) -> None:
    path = Path(str(SCOPE["wrapper_execution_receipt_out"])).resolve()
    root = Path(str(SCOPE["attempt_root"])).resolve()
    if root != path and root not in path.parents:
        return
    if path.exists():
        return
    artifacts = {}
    for name in (
        "doctor_receipt_out",
        "geography_precredential_receipt_out",
        "geography_premutation_receipt_out",
        "bootstrap_out",
        "command_receipt_out",
        "user_stream_journal_out",
    ):
        candidate = Path(str(SCOPE[name])).resolve()
        if candidate.is_file():
            artifacts[name] = {"path": str(candidate), "sha256": _sha256(candidate)}
    command = None
    command_path = Path(str(SCOPE["command_receipt_out"])).resolve()
    if command_path.is_file():
        try:
            command = json.loads(command_path.read_text(encoding="utf-8-sig"))
        except (OSError, json.JSONDecodeError):
            command = None
    _atomic_json(
        path,
        {
            "schema_version": "international_live_fixed_scope_execution_v0.7",
            "stage": "stage0",
            "execution_host_profile": SCOPE["execution_host_profile"],
            "execution_host_id": SCOPE["execution_host_id"],
            "status": status,
            "finished_at_local": datetime.now().astimezone().isoformat(),
            "production_tip": SCOPE["expected_production_tip"],
            "target_date": SCOPE["target_date"],
            "condition_id": SCOPE["condition_id"],
            "token_id": SCOPE["token_id"],
            "requested_budget_pusd": float(SCOPE["requested_budget_pusd"]),
            "wrapper": {
                "path": str(Path(__file__).resolve()),
                "sha256": _sha256(Path(__file__).resolve()),
            },
            "phase": EXECUTION_PHASE,
            "confirmation_scope_display_sha256": CONFIRMATION_SCOPE_DISPLAY_SHA256,
            "host_attestations": list(HOST_ATTESTATIONS),
            "credential_values_read_in_memory": (
                command.get("credential_values_read_in_memory", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "live_mutation_attempted": (
                command.get("exchange_mutation_attempted", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "order_submit_attempted": (
                command.get("order_submit_attempted", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "authenticated_exchange_write_attempted": (
                command.get("authenticated_exchange_write_attempted", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "authenticated_user_stream_subscription_sent": (
                command.get(
                    "authenticated_user_stream_subscription_sent",
                    "UNKNOWN",
                )
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "bootstrap_phase": (
                command.get("bootstrap_phase", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "bootstrap_recovery_phase": (
                command.get("bootstrap_recovery_phase", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "exchange_mutation_attempt_counts": (
                command.get("exchange_mutation_attempt_counts", "UNKNOWN")
                if isinstance(command, dict)
                else "UNKNOWN"
            ),
            "exception_type": exception_type,
            "artifacts": artifacts,
            "secret_values_redacted": True,
        },
    )


def main() -> int:
    global CONFIRMATION_SCOPE_DISPLAY_SHA256, EXECUTION_PHASE
    if len(sys.argv) != 1:
        raise RuntimeError("fixed-scope Stage 0 wrapper accepts no arguments")
    _assert_sealed()
    _assert_git_and_sources()
    _assert_paths()
    _assert_host_state()
    _assert_attended_invocation()

    EXECUTION_PHASE = "sdk_overlay_validation"
    sys.path.insert(0, str(PRODUCTION / "src"))
    from weather.market.live_sdk_overlay import activate_live_sdk_overlay

    sdk_activation = activate_live_sdk_overlay(
        SCOPE["sdk_overlay_manifest_path"],
        SCOPE["sdk_overlay_manifest_sha256"],
    )
    from weather.market import mm_live_pilot_cli as live_cli
    from weather.market.mm_live_stage0_scope import (
        load_stage0_scope_gate,
        validate_bound_stage0_event_metadata,
    )

