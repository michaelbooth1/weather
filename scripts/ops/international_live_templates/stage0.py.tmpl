    EXECUTION_PHASE = "command_authorization"
    CONFIRMATION_SCOPE_DISPLAY_SHA256 = _display_confirmation_scope()
    expected_confirmation = "INTERNATIONAL_POLYMARKET_STAGE0_HEARTBEAT_AND_ACCOUNT_WIDE_CANCEL_ALL_NO_ORDER"
