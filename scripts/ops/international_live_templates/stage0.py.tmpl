if __name__ == "__main__":
    try:
        exit_code = main()
    except BaseException as exc:
        if _is_fully_sealed():
            try:
                _write_execution_receipt("FAIL", type(exc).__name__)
            except BaseException:
                pass
        print(
            json.dumps(
                {
                    "status": "FAIL",
                    "stage": "stage0",
                    "exception_type": type(exc).__name__,
                    "secret_values_redacted": True,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        raise SystemExit(1)
    raise SystemExit(exit_code)
